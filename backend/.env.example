# SafeRoute Backend Environment Configuration
PROJECT_NAME="SafeRoute — Crisis Communication for Tourists"
ENVIRONMENT=development

# -------------------------------------------------------------------
# Database Configuration (Supabase PostgreSQL vs Local SQLite)
# -------------------------------------------------------------------

# Option 1: Supabase IPv4 Session Pooler (RECOMMENDED for Render & Local IPv4 connections)
# Host: aws-0-ap-southeast-1.pooler.supabase.com | Port: 5432 | User: postgres.ijbsprdkrhnimhiknpxe
DATABASE_URL=postgresql://postgres.ijbsprdkrhnimhiknpxe:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Option 2: Supabase Direct Connection (Requires IPv6 network support)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.ijbsprdkrhnimhiknpxe.supabase.co:5432/postgres

# Option 3: Local SQLite (Zero-config offline development fallback)
# DATABASE_URL=sqlite:///./saferoute.db

# -------------------------------------------------------------------
# Security & Auth
# -------------------------------------------------------------------
# Secret key for signing HMAC session tokens (Change in production!)
SECRET_KEY=saferoute-super-secure-crisis-comm-key-2026

# -------------------------------------------------------------------
# CORS Configuration
# -------------------------------------------------------------------
# Comma-separated list of permitted origins (e.g. for deployed Vercel frontend)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
